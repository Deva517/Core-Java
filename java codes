                    System.out.println("\n      NOVEMBER 2026"); 
                    break;
                case 12: 
                    System.out.println("\n      DECEMBER 2026"); 
                    break;
            }

            System.out.println("Sun Mon Tue Wed Thu Fri Sat");

            switch (startDay) {
                case 0: 
                    break;
                case 1: 
                    System.out.print("    "); 
                    break;
                case 2: 
                    System.out.print("        "); 
                    break;
                case 3: 
                    System.out.print("            "); 
                    break;
                case 4: 
                    System.out.print("                "); 
                    break;
                case 5: 
                    System.out.print("                    "); 
                case 6: System.out.print("                        "); break;
            }

            int day = 1;

            while (day <= days) {

                System.out.printf("%3d ", day);

                if ((startDay + day) % 7 == 0) {
                    System.out.println();
                }

                day++;
            }

            System.out.println();

            startDay = (startDay + days) % 7;

            

            month++;
        }
    }
}


**Table**
public class datatypes {
    public static void main(String[] args) {

        for(int i=1;i<=5;i++){
             System.out.println(i+"table:");
            if(i%2==0){
                System.out.println("Even table:");
            }
            else{
                System.out.println("Odd table:");
            }
            
            for(int j=1;j<=10;j++){
                 
              System.out.println(i+"*"+j+"="+(i*j)+"   ");
                
            }
             System.out.println();
        }

    }
}



