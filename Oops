--Abstract class--
abstract class mts {
    abstract void display();

    void venu() {
        System.out.println("Welcome to MITS University!");
    }
}

class Student extends mts {
    int id;
    String name;
    double cgpa;

    void display() {
        System.out.println("Student ID: " + id);
        System.out.println("Student Name: " + name);
        System.out.println("CGPA: " + cgpa);
    }
}
public class mtsdemo {
    public static void main(String[] args) {
        Student s = new Student();

        s.id = 101;
        s.name = "Deva";
        s.cgpa = 9.2;

        s.display();
        s.venu();
    }
}


